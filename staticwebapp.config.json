{
  "platform": { "apiRuntime": "node:22" },
  "routes": [
    { "route": "/gallery.html", "allowedRoles": ["anonymous"] },
    { "route": "/assets/gallery/*", "allowedRoles": ["anonymous"] },
    { "route": "/gallery-admin.html", "allowedRoles": ["gallery"] },
    { "route": "/docs/*", "statusCode": 404 },
    { "route": "/database/*", "statusCode": 404 },
    { "route": "/api/src/*", "statusCode": 404 },
    { "route": "/api/tests/*", "statusCode": 404 },
    { "route": "/api/dev-preview.mjs", "statusCode": 404 },
    { "route": "/api/local.settings.example.json", "statusCode": 404 },
    { "route": "/api/package.json", "statusCode": 404 },
    { "route": "/api/package-lock.json", "statusCode": 404 },
    { "route": "/api/host.json", "statusCode": 404 },
    { "route": "/scripts/*", "statusCode": 404 },
    { "route": "/README*", "statusCode": 404 },
    { "route": "/.github/*", "statusCode": 404 },
    { "route": "/.gitignore", "statusCode": 404 }
  ]
}
